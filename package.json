{
  "name": "bean-and-brew-demo",
  "private": true,
  "version": "0.1.0",
  "description": "A small coffee shop web app with a mock backend, built as a target for UI and API test automation.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "api": "node server/index.js",
    "build": "vite build",
    "build:android": "vite build --mode android && cap sync android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "preview": "concurrently -k -n api,web -c blue,green \"npm:api\" \"vite preview\"",
    "demo:record": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "@capacitor/android": "6.2.3",
    "@capacitor/core": "6.2.3",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.3",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "vite": "^8.3.5"
  }
}
